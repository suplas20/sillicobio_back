PROJECT_NAME=SillicoBio API
API_VERSION=1.0.0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sillicobio
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+|192\.168\.\d+\.\d+)(:\d+)?$
SESSION_SECRET_KEY=change-me-in-local-env
SESSION_COOKIE_NAME=SESSION
SESSION_HTTPS_ONLY=false
UPLOAD_DIR=uploads
