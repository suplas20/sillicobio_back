    {
      "name": "02 쓰기 요청 예시",
      "description": "이 폴더의 요청은 데이터베이스를 변경합니다. 테스트 데이터가 생성되거나 수정될 수 있으므로 필요한 경우에만 실행하세요.",
      "item": [
        {
          "name": "회원 등록",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{newMemberId}}\",\n  \"name\": \"포스트맨 사용자\",\n  \"password\": \"1234\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ]
            }
          }
        },
        {
          "name": "연구자 등록",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.environment.set('createdResearcherId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"포스트맨 연구자\",\n  \"email\": \"postman.researcher@sillicobio.local\",\n  \"tel\": \"010-0000-0000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/researchers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "researchers"
              ]
            }
          }
        },
        {
          "name": "실험계획 등록 및 배치 4개 생성",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.plan && json.plan.id) pm.environment.set('createdPlanId', json.plan.id);",
                  "if (json.batches && json.batches[0]) pm.environment.set('createdBatchId', json.batches[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Postman API 테스트용 실험계획\",\n  \"strain\": \"Saccharomyces cerevisiae SB-LUT-01\",\n  \"batch1\": \"대조 조건\",\n  \"batch2\": \"Feed glucose 상향 조건\",\n  \"batch3\": \"접종비 변경 조건\",\n  \"batch4\": \"온도 최적화 조건\",\n  \"cmp\": null,\n  \"result\": \"Postman 컬렉션에서 생성한 테스트 데이터입니다.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ]
            }
          }
        },
        {
          "name": "배치 상세 저장",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDt\": \"20260610\",\n  \"params\": {\n    \"prepTime\": 24,\n    \"equipVol\": 5,\n    \"purifyYield\": 0.85,\n    \"dcwOdFactor\": 0.31,\n    \"feedGlucoseConc\": 600,\n    \"feedDensity\": 1.2,\n    \"feedGlucosePerFeed\": 0.5\n  },\n  \"comparison\": {\n    \"type\": \"ALL\",\n    \"targetBatchId\": null\n  },\n  \"researchers\": [\n    { \"role\": \"RES1\", \"id\": \"{{researcherId}}\" }\n  ],\n  \"samplingRows\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}/detail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "batches",
                "{{batchId}}",
                "detail"
              ]
            }
          }
        },
        {
          "name": "샘플링 데이터 저장",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rows\": [\n    {\n      \"samplingTime\": 0,\n      \"od\": 0.2,\n      \"feedWeight\": 0,\n      \"brothVolume\": 5,\n      \"targetProdConc\": 0,\n      \"glucoseConc\": 20,\n      \"lycopene\": 0,\n      \"aCarotene\": 0,\n      \"bCarotene\": 0,\n      \"citricAcid\": 0,\n      \"pyruvicAcid\": 0,\n      \"succinicAcid\": 0,\n      \"lacticAcid\": 0,\n      \"aceticAcid\": 0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}/sampling",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "batches",
                "{{batchId}}",
                "sampling"
              ]
            }
          }
        },
        {
          "name": "실험계획 파일 업로드",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fileType",
                  "value": "PLAN",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/plans/{{planId}}/files",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "{{planId}}",
                "files"
              ]
            }
          }
        },
        {
          "name": "배치 파일 업로드",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fileType",
                  "value": "DO_PH",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}/files",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "batches",
                "{{batchId}}",
                "files"
              ]
            }
          }
        }
      ]
