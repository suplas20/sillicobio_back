          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/members?page=1&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
