{
  "info": {
    "_postman_id": "6d5139c5-7f88-4c67-8702-e2ebc54f0001",
    "name": "SillicoBio LIMS API",
    "description": "SillicoBio LIMS FastAPI 백엔드용 Postman 컬렉션입니다. 함께 제공되는 환경 파일을 가져온 뒤, 세션 인증이 필요한 요청을 실행하기 전에 00 인증 > 관리자로 로그인 요청을 먼저 실행하세요. Postman은 로그인 후 발급되는 SESSION 쿠키를 자동으로 보관합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP 상태 코드가 성공 범위입니다', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 인증",
      "item": [
        {
          "name": "관리자로 로그인",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('loggedInUserId', json.id);",
                  "pm.environment.set('loggedInRole', json.role);",
                  "pm.test('관리자 권한으로 로그인되었습니다', function () {",
                  "  pm.expect(json.role).to.eql('ADMIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{adminId}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "현재 로그인 사용자 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "로그아웃",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 스모크 테스트 - 조회 전용",
      "description": "먼저 로그인 요청을 실행하세요. 이 폴더의 요청은 데이터베이스를 변경하지 않는 조회 전용 요청입니다.",
      "item": [
