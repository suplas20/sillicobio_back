    {
      "name": "02 Write Examples",
      "description": "These requests mutate the database. Run them intentionally.",
      "item": [
        {
          "name": "Create member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{newMemberId}}\",\n  \"name\": \"Postman User\",\n  \"password\": \"1234\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ]
            }
          }
        },
        {
          "name": "Create researcher",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.environment.set('createdResearcherId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Researcher\",\n  \"email\": \"postman.researcher@sillicobio.local\",\n  \"tel\": \"010-0000-0000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/researchers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "researchers"
              ]
            }
          }
        },
        {
          "name": "Create plan with four batches",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.plan && json.plan.id) pm.environment.set('createdPlanId', json.plan.id);",
                  "if (json.batches && json.batches[0]) pm.environment.set('createdBatchId', json.batches[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Postman API test plan\",\n  \"strain\": \"Saccharomyces cerevisiae SB-LUT-01\",\n  \"batch1\": \"Control condition\",\n  \"batch2\": \"Feed glucose up\",\n  \"batch3\": \"Inoculation ratio change\",\n  \"batch4\": \"Temperature optimization\",\n  \"cmp\": null,\n  \"result\": \"Created from Postman collection.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ]
            }
          }
        },
        {
          "name": "Update batch detail",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDt\": \"20260610\",\n  \"params\": {\n    \"prepTime\": 24,\n    \"equipVol\": 5,\n    \"purifyYield\": 0.85,\n    \"dcwOdFactor\": 0.31,\n    \"feedGlucoseConc\": 600,\n    \"feedDensity\": 1.2,\n    \"feedGlucosePerFeed\": 0.5\n  },\n  \"comparison\": {\n    \"type\": \"ALL\",\n    \"targetBatchId\": null\n  },\n  \"researchers\": [\n    { \"role\": \"RES1\", \"id\": \"{{researcherId}}\" }\n  ],\n  \"samplingRows\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}/detail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "batches",
                "{{batchId}}",
                "detail"
              ]
            }
          }
        },
        {
          "name": "Save sampling rows",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rows\": [\n    {\n      \"samplingTime\": 0,\n      \"od\": 0.2,\n      \"feedWeight\": 0,\n      \"brothVolume\": 5,\n      \"targetProdConc\": 0,\n      \"glucoseConc\": 20,\n      \"lycopene\": 0,\n      \"aCarotene\": 0,\n      \"bCarotene\": 0,\n      \"citricAcid\": 0,\n      \"pyruvicAcid\": 0,\n      \"succinicAcid\": 0,\n      \"lacticAcid\": 0,\n      \"aceticAcid\": 0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}/sampling",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "batches",
                "{{batchId}}",
                "sampling"
              ]
            }
          }
        },
        {
          "name": "Upload plan file",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fileType",
                  "value": "PLAN",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/plans/{{planId}}/files",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "{{planId}}",
                "files"
              ]
            }
          }
        },
        {
          "name": "Upload batch file",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fileType",
                  "value": "DO_PH",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}/files",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "batches",
                "{{batchId}}",
                "files"
              ]
            }
          }
        }
      ]
    }
